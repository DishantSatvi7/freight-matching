# Server
PORT=5000
NODE_ENV=development

# Database (Cloud PostgreSQL + PostGIS)
# Direct connection (port 5432) for schema migrations and psql CLI
DATABASE_URL_DIRECT=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Pooled connection (port 6543) for Node.js backend app
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# External APIs
GOOGLE_MAPS_API_KEY=your_key_here
STRIPE_SECRET_KEY=your_stripe_key_here
