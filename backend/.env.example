# ============================================================
# Phase 3: Production Environment Variables Reference
# ============================================================

# 1. App Core
NODE_ENV=development
PORT=5000
API_VERSION=v1

# 2. Database (PostgreSQL + PostGIS)
# Direct connection (port 5432) for migrations & CLI
DATABASE_URL_DIRECT=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
# Pooled connection (port 6543) for Node.js backend
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_SSL=true

# 3. Authentication
# Generate 64-char key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_char_hex_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# 4. CORS / Frontend
FRONTEND_URL=https://backhaul2.netlify.app
ALLOWED_ORIGINS=https://backhaul2.netlify.app,https://freight-matching.vercel.app

# 5. External APIs
GOOGLE_MAPS_BACKEND_KEY=AIzaSy_your_server_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
