# ============================================================
# ROOT — covers both frontend/ and backend/
# ============================================================

# ──────────────────────────────
# Dependencies
# ──────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ──────────────────────────────
# Environment / Secrets ← CRITICAL
# ──────────────────────────────
.env
.env.*
!.env.example # allow example files
!.env.*.example

# ──────────────────────────────
# Next.js (frontend/)
# ──────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel

# ──────────────────────────────
# Node.js / Express (backend/)
# ──────────────────────────────
backend/dist/
backend/build/
backend/*.js.map

# ──────────────────────────────
# Logs
# ──────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log.*

# ──────────────────────────────
# OS / Editor
# ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo
.cache/

# ──────────────────────────────
# Testing
# ──────────────────────────────
coverage/
.nyc_output/

# ──────────────────────────────
# Misc
# ──────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx
